    <!-- Support Dialog strings -->
    <string name="support">मदत</string>
    <string name="support_dialog_title">मदत आणि अभिप्राय</string>
    <string name="support_dialog_description">मदत हवी आहे की काही सूचना आहेत? support@upalio.com वर आमच्याशी संपर्क साधा. आम्हाला तुमच्याकडून ऐकायला आवडेल!</string>
