    <!-- Terms & Conditions Dialog strings -->
    <string name="terms">नियम और शर्तें</string>
    <string name="terms_dialog_title">नियम और शर्तें</string>
    <string name="terms_dialog_description">Local Feast का उपयोग करके, आप निम्न के लिए सहमत हैं:\n\n1. सामुदायिक भंडारों के स्थलों और स्वयंसेवकों का सम्मान करें।\n2. सटीक स्थान की जानकारी साझा करें।\n3. स्थानीय स्वच्छता और व्यापार नियमों का पालन करें।\n\nहम सुरक्षा और सटीकता के लिए पोस्ट्स और प्रविष्टियों को मॉडरेट करने का अधिकार सुरक्षित रखते हैं।</string>
    <string name="terms_dialog_close">स्वीकार करें और बंद करें</string>

