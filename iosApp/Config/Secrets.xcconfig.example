// Copy to Secrets.xcconfig (not in git) and fill in.
// Google Maps API key for iOS: Google Cloud > Credentials, restricted to the iOS app
// com.localfeast.app and the "Maps SDK for iOS" API.
MAPS_API_KEY = 

// The backend the app talks to, ending with "/". xcconfig treats "//" as a comment, so write
// "https:/$()/api.example.com/" for https://api.example.com/ (or http:/$()/localhost:8080/ for a local backend).
API_BASE_URL = 

// Google Sign-In: the REVERSED_CLIENT_ID value from GoogleService-Info.plist (the iOS OAuth client in Firebase),
// e.g. com.googleusercontent.apps.1234-abcd. Lets Google's sign-in page return to the app.
GOOGLE_REVERSED_CLIENT_ID = 
